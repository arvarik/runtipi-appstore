{
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "contrack-init",
      "image": "ghcr.io/arvarik/contrack:2.0.6",
      "user": "0:0",
      "restart": "no",
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "command": [
        "chown -R 1000:1000 /app/data"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data"
        }
      ]
    },
    {
      "name": "contrack",
      "image": "ghcr.io/arvarik/contrack:2.0.6",
      "internalPort": 3210,
      "isMain": true,
      "dependsOn": {
        "contrack-init": {
          "condition": "service_completed_successfully"
        }
      },
      "environment": [
        {
          "key": "AUTH_REQUIRED",
          "value": "true"
        },
        {
          "key": "TRUST_PROXY_HOPS",
          "value": "1"
        },
        {
          "key": "PUBLIC_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN:-localhost:3210}"
        },
        {
          "key": "ALLOWED_HOSTS",
          "value": ".local,.lan,.ts.net,${LOCAL_DOMAIN:-},${APP_LOCAL_DOMAIN:-},${CONTRACK_ALLOWED_HOSTS:-}"
        },
        {
          "key": "AI_DISABLED",
          "value": "${CONTRACK_AI_DISABLED:-false}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/data"
        }
      ]
    }
  ]
}
